# ==============================================================================
# BountyOS Home-Lab Environment Configuration Template
# Copy this file to .env before starting services:
#   cp .env.example .env
# Generate secrets:
#   openssl rand -hex 32
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (PostgreSQL 15)
# ------------------------------------------------------------------------------
POSTGRES_DB=bountyos
POSTGRES_USER=bountyos
# Generate a strong password: openssl rand -base64 24
POSTGRES_PASSWORD=replace_with_secure_postgres_password

# ------------------------------------------------------------------------------
# 2. Redis 7
# ------------------------------------------------------------------------------
# Generate a strong password: openssl rand -base64 24
REDIS_PASSWORD=replace_with_secure_redis_password

# ------------------------------------------------------------------------------
# 3. Authentication & Security
# ------------------------------------------------------------------------------
# Generate a 32-byte secret: openssl rand -hex 32
JWT_SECRET=replace_with_random_32_byte_secret_minimum

# ------------------------------------------------------------------------------
# 4. Rust API Server (bountyos-server)
# ------------------------------------------------------------------------------
# Private interface binding (default: 127.0.0.1 prevents public exposure)
# Set to 0.0.0.0 or your specific LAN IP (e.g., 192.168.1.50) for LAN access
SERVER_BIND_IP=127.0.0.1
SERVER_PORT=8000

# Logging level (error | warn | info | debug | trace)
RUST_LOG=info

# Set to true for initial schema migration and setup
FIRST_RUN=true

# Conservative job limit for Core i3 (2 cores / 4 threads) and 8 GB RAM
MAX_CONCURRENT_JOBS=2

# Evidence path for application artifacts (persisted outside container layers)
EVIDENCE_BASE_PATH=./evidence

# ------------------------------------------------------------------------------
# 5. LLM Triage Subsystem
# ------------------------------------------------------------------------------
# Disabled by default to preserve RAM on 8 GB home-lab host
LLM_ENABLED=false
LLM_OLLAMA_URL=http://localhost:11434
LLM_MODEL=vulnllm-r-7b

# ------------------------------------------------------------------------------
# 6. Frontend (Next.js 14 Web UI)
# ------------------------------------------------------------------------------
# Private interface binding (default: 127.0.0.1 prevents public exposure)
# Set to 0.0.0.0 or your specific LAN IP for LAN browser access
FRONTEND_BIND_IP=127.0.0.1
FRONTEND_PORT=3000

# Backend proxy URL inside the Docker network or LAN
BACKEND_URL=http://server:8000

# Client-facing API and WebSocket paths
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_WS_URL=/ws

# ------------------------------------------------------------------------------
# 7. Optional Nginx Reverse Proxy (Profile: proxy)
# ------------------------------------------------------------------------------
NGINX_BIND_IP=127.0.0.1
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ------------------------------------------------------------------------------
# 8. MCP (Model Context Protocol) Server for AI Agents
# ------------------------------------------------------------------------------
MCP_BIND_IP=127.0.0.1
MCP_PORT=3005
