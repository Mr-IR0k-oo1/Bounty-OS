{
  "name": "bountyos-mcp",
  "version": "1.0.0",
  "type": "module",
  "description": "Model Context Protocol (MCP) server for BountyOS - connects AI agents to bug bounty programs, scope, recon assets, and findings",
  "main": "dist/index.js",
  "bin": {
    "bountyos-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "node dist/tests/unit.test.js",
    "test:integration": "node dist/tests/integration.test.js",
    "test:all": "node dist/tests/unit.test.js; node dist/tests/integration.test.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "bountyos",
    "bug-bounty",
    "security",
    "recon",
    "agents"
  ],
  "author": "BountyOS Team",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "dotenv": "^16.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.19.2",
    "typescript": "^5.3.3"
  }
}
