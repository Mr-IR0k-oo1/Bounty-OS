[Unit]
Description=Bounty OS Rust API Server
After=network.target postgresql.service redis.service
Wants=postgresql.service redis.service

[Service]
Type=simple
User=bountyos
Group=bountyos
WorkingDirectory=/opt/bountyos
EnvironmentFile=/opt/bountyos/.env
ExecStart=/opt/bountyos/target/release/bountyos-server
Restart=always
RestartSec=5
LimitNOFILE=65535
MemoryMax=1G
TasksMax=128

[Install]
WantedBy=multi-user.target
